{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucketMultipartUploads", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:${partition}:s3:::${bucket}"
    },
    {
      "Sid": "ObjectReadWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:ListMultipartUploadParts", "s3:GetObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:${partition}:s3:::${bucket}/*"
    },
    {
      "Sid": "BucketKey",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
      "Resource": "${kms_key_arn}"
    }%{ if ecr_token },
    {
      "Sid": "ECRTokenHardAWSLimit",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    }%{ endif }
  ]
}
